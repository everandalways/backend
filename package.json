{
  "name": "ena_backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node ./src/index.ts",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "dev": "concurrently npm:dev:*",
    "build": "tsc",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "concurrently npm:start:*",
    "start:prod": "concurrently --kill-others --names server,worker --prefix-colors blue,magenta \"npm:start:server\" \"npm:start:worker\"",
    "import": "npx ts-node ./src/scripts/import-products.ts",
    "verify:webhook": "ts-node ./src/scripts/verify-stripe-webhook.ts",
    "verify:config": "ts-node ./src/scripts/verify-config.ts",
    "check:jobs": "ts-node ./src/scripts/check-job-health.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.750.0",
    "@aws-sdk/lib-storage": "3.750.0",
    "@nestjs/throttler": "^6.5.0",
    "@vendure/admin-ui-plugin": "3.4.2",
    "@vendure/asset-server-plugin": "3.4.2",
    "@vendure/core": "3.4.2",
    "@vendure/email-plugin": "3.4.2",
    "@vendure/graphiql-plugin": "3.4.2",
    "@vendure/payments-plugin": "^3.4.2",
    "concurrently": "9.2.1",
    "dotenv": "17.2.2",
    "pg": "8.16.3",
    "stripe": "^13.11.0"
  },
  "devDependencies": {
    "@vendure/cli": "3.4.2",
    "@vendure/create": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2"
  }
}
